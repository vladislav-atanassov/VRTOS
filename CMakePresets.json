{
  "version": 3,
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "stm32f446re_nucleo",
      "displayName": "STM32F446RE Nucleo",
      "description": "Configure for the STM32F446RE Nucleo board",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "KARTOS_BOARD": "stm32f446re_nucleo",
        "KARTOS_TEST_HOOKS": "ON"
      }
    },
    {
      "name": "stm32f401re_nucleo",
      "displayName": "STM32F401RE Nucleo",
      "description": "Configure for the STM32F401RE Nucleo board",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "KARTOS_BOARD": "stm32f401re_nucleo",
        "KARTOS_TEST_HOOKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "all",
      "displayName": "Build all variants",
      "configurePreset": "stm32f446re_nucleo"
    },

    { "name": "basic_blinky",                  "configurePreset": "stm32f446re_nucleo", "targets": ["basic_blinky"] },
    { "name": "stm32f401re_nucleo-basic_blinky", "displayName": "Build basic_blinky (F401RE)", "configurePreset": "stm32f401re_nucleo", "targets": ["basic_blinky"] },
    { "name": "producer_consumer",             "configurePreset": "stm32f446re_nucleo", "targets": ["producer_consumer"] },
    { "name": "profiling_demo",                "configurePreset": "stm32f446re_nucleo", "targets": ["profiling_demo"] },
    { "name": "fpu_context_test",              "configurePreset": "stm32f446re_nucleo", "targets": ["fpu_context_test"] },

    { "name": "test_mutex_suite",                    "configurePreset": "stm32f446re_nucleo", "targets": ["test_mutex_suite"] },
    { "name": "test_semaphore_suite",               "configurePreset": "stm32f446re_nucleo", "targets": ["test_semaphore_suite"] },
    { "name": "test_queue_suite",                   "configurePreset": "stm32f446re_nucleo", "targets": ["test_queue_suite"] },
    { "name": "test_event_group_suite",             "configurePreset": "stm32f446re_nucleo", "targets": ["test_event_group_suite"] },
    { "name": "test_notify_suite",                  "configurePreset": "stm32f446re_nucleo", "targets": ["test_notify_suite"] },
    { "name": "test_task_state_suite",              "configurePreset": "stm32f446re_nucleo", "targets": ["test_task_state_suite"] },
    { "name": "test_scheduler_cooperative_suite",   "configurePreset": "stm32f446re_nucleo", "targets": ["test_scheduler_cooperative_suite"] },
    { "name": "test_scheduler_rr_suite",            "configurePreset": "stm32f446re_nucleo", "targets": ["test_scheduler_rr_suite"] },
    { "name": "test_scheduler_preemptive_suite",    "configurePreset": "stm32f446re_nucleo", "targets": ["test_scheduler_preemptive_suite"] },
    { "name": "test_tickless_idle_suite",           "configurePreset": "stm32f446re_nucleo", "targets": ["test_tickless_idle_suite"] },
    { "name": "test_heap_allocator_suite",          "configurePreset": "stm32f446re_nucleo", "targets": ["test_heap_allocator_suite"] },
    { "name": "test_hooks_suite",                   "configurePreset": "stm32f446re_nucleo", "targets": ["test_hooks_suite"] },

    { "name": "bench_context_switch",          "configurePreset": "stm32f446re_nucleo", "targets": ["bench_context_switch"] },
    { "name": "bench_mutex",                   "configurePreset": "stm32f446re_nucleo", "targets": ["bench_mutex"] },
    { "name": "bench_queue",                   "configurePreset": "stm32f446re_nucleo", "targets": ["bench_queue"] },
    { "name": "bench_semaphore",               "configurePreset": "stm32f446re_nucleo", "targets": ["bench_semaphore"] },

    { "name": "flash-basic_blinky",            "configurePreset": "stm32f446re_nucleo", "targets": ["flash-basic_blinky"] },
    { "name": "flash-producer_consumer",       "configurePreset": "stm32f446re_nucleo", "targets": ["flash-producer_consumer"] },
    { "name": "flash-profiling_demo",          "configurePreset": "stm32f446re_nucleo", "targets": ["flash-profiling_demo"] },
    { "name": "flash-fpu_context_test",        "configurePreset": "stm32f446re_nucleo", "targets": ["flash-fpu_context_test"] },

    { "name": "flash-test_mutex_suite",                  "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_mutex_suite"] },
