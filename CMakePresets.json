    { "name": "flash-test_event_group_suite",           "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_event_group_suite"] },
    { "name": "flash-test_notify_suite",                "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_notify_suite"] },
    { "name": "flash-test_task_state_suite",            "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_task_state_suite"] },
    { "name": "flash-test_scheduler_cooperative_suite", "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_scheduler_cooperative_suite"] },
    { "name": "flash-test_scheduler_rr_suite",          "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_scheduler_rr_suite"] },
    { "name": "flash-test_scheduler_preemptive_suite",  "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_scheduler_preemptive_suite"] },
    { "name": "flash-test_tickless_idle_suite",         "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_tickless_idle_suite"] },
    { "name": "flash-test_heap_allocator_suite",        "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_heap_allocator_suite"] },
    { "name": "flash-test_hooks_suite",                 "configurePreset": "stm32f446re_nucleo", "targets": ["flash-test_hooks_suite"] },

    { "name": "flash-bench_context_switch",    "configurePreset": "stm32f446re_nucleo", "targets": ["flash-bench_context_switch"] },
    { "name": "flash-bench_mutex",             "configurePreset": "stm32f446re_nucleo", "targets": ["flash-bench_mutex"] },
    { "name": "flash-bench_queue",             "configurePreset": "stm32f446re_nucleo", "targets": ["flash-bench_queue"] },
    { "name": "flash-bench_semaphore",         "configurePreset": "stm32f446re_nucleo", "targets": ["flash-bench_semaphore"] }
  ]
